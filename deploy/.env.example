# MongoDB Atlas connection string (the VPS IP must be whitelisted in Atlas)
MDB_MCP_CONNECTION_STRING=mongodb+srv://user:pass@cluster.mongodb.net/global

# Bearer token for auth — generate with: openssl rand -hex 32
# This same token goes in the Managed Agents vault credential.
MCP_BEARER_TOKEN=

# Domain pointing to this VPS (A record → VPS static IP)
DOMAIN=mongo-mcp.yourdomain.com

# Query timeout (optional, default 60000ms)
MCP_MAX_TIME_MS=60000
