# Caddy reverse proxy for MongoDB MCP server.
# Provides auto-TLS via Let's Encrypt — zero cert management.
#
# Replace {$DOMAIN} with your actual domain, e.g.:
#   DOMAIN=mongo-mcp.yourdomain.com caddy run
#
# Or hard-code the domain:
#   mongo-mcp.yourdomain.com {
#     reverse_proxy localhost:8080
#   }

{$DOMAIN} {
	reverse_proxy mongo-mcp:8080
}
