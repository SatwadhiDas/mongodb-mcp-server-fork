# Multi-stage build: builds the fork from source, then runs in HTTP mode.
# No code changes needed — the fork already supports HTTP transport,
# header-based auth (httpHeaders), and health checks (MonitoringServer).

FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY . .
RUN pnpm run build

FROM node:22-alpine
RUN addgroup -S mcp && adduser -S mcp -G mcp
WORKDIR /home/mcp
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY entrypoint-http.sh ./
RUN chmod +x entrypoint-http.sh
USER mcp

# MCP HTTP server
EXPOSE 8080
# Health check / monitoring (separate port)
EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD wget -qO- http://localhost:8081/health || exit 1

ENTRYPOINT ["./entrypoint-http.sh"]
